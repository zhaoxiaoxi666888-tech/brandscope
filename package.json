{
  "name": "brandscope",
  "version": "1.1.0",
  "private": true,
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "next dev",
    "postinstall": "prisma generate",
    "build": "next build",
    "start": "next start",
    "test": "tsx --test tests/*.test.mjs tests/*.test.ts",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "typecheck": "tsc --noEmit",
    "db:generate": "node scripts/prisma-with-env.mjs generate",
    "db:migrate": "node scripts/prisma-with-env.mjs db push",
    "db:deploy": "node scripts/prisma-with-env.mjs db push && pnpm db:secure",
    "db:secure": "node scripts/enable-rls.mjs",
    "db:seed": "tsx prisma/seed.ts",
    "setup": "pnpm db:generate && pnpm db:deploy",
    "db:studio": "prisma studio",
    "deepseek:models": "tsx scripts/list-deepseek-models.ts"
  },
  "dependencies": {
    "@prisma/client": "6.19.0",
    "@supabase/supabase-js": "^2.110.7",
    "cheerio": "^1.2.0",
    "next": "16.2.6",
    "openai": "^6.48.0",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "undici": "7.28.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "prisma": "6.19.0",
    "tailwindcss": "4.2.1",
    "tsx": "4.20.6",
    "typescript": "5.9.3"
  },
  "type": "module"
}
