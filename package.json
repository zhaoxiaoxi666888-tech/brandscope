{
  "name": "brandscope",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "test": "tsx --test tests/*.test.mjs tests/*.test.ts",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "typecheck": "tsc --noEmit",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:seed": "tsx prisma/seed.ts",
    "setup": "prisma generate && prisma migrate deploy && tsx prisma/seed.ts",
    "db:studio": "prisma studio",
    "deepseek:models": "tsx scripts/list-deepseek-models.ts"
  },
  "dependencies": {
    "@prisma/client": "6.19.0",
    "cheerio": "^1.2.0",
    "next": "16.2.6",
    "openai": "^6.48.0",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "undici": "7.28.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "prisma": "6.19.0",
    "tailwindcss": "4.2.1",
    "tsx": "4.20.6",
    "typescript": "5.9.3"
  },
  "type": "module"
}
